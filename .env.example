# Copy to .env and fill in. Never commit .env.

# Meta Model API (Muse Spark 1.3 for photos and as the agent's fallback, Muse Voice Transcribe) - https://dev.meta.ai
MODEL_API_KEY=

# Baseten (Muse Spark Open, open weights)
BASETEN_API_KEY=

# Optional: the same open-weight model on a Modal Shared Endpoint, the agent's first fallback.
# `modal endpoint create --shared --model meta-models/Muse-Spark-Open-816B-A42B`, then a proxy token
# (`modal workspace proxy-tokens create`) written as <wk-id>.<ws-secret>.
MODAL_BASE_URL=https://<workspace>--ep-<name>-server.us-west.modal.direct/v1
MODAL_API_KEY=
